# Port Server
PORT=3000

# Mode Integrasi Google Workspace: 'service_account', 'apps_script', atau 'mock'
GOOGLE_INTEGRATION_MODE=apps_script

# Google Spreadsheet ID (dapat diambil dari URL Google Sheets)
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Path ke file Service Account Credentials JSON (jika menggunakan mode Service Account)
GOOGLE_SERVICE_ACCOUNT_KEY=./server/credentials.json

# URL Google Apps Script Web App (jika menggunakan mode Google Apps Script)
# Contoh: https://script.google.com/macros/s/AKfycbw.../exec
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx_EXAMPLE_WEBAPP_ID/exec

# ID Root Folder Google Drive (opsional, jika kosong sistem akan mencari/membuat folder 'SIMAGA_Storage')
GOOGLE_DRIVE_ROOT_FOLDER_ID=
